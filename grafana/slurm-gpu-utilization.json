{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Production Prometheus (monitoring:9090) — needs both DCGM_FI_DEV_GPU_UTIL and slurm_job_gpu_index / slurm_user_partition_gpus_running.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "GPUs in service",
      "description": "Total GPU count across the cluster, excluding titanrtx/titanxp (off-cluster).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(slurm_gpus_total_by_type{gpu_type!~\"titanrtx|titanxp\"})",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Avg concurrent GPUs allocated (window)",
      "description": "Average over the dashboard time window of (total GPUs allocated to running jobs at each instant). Computed correctly by summing across users first, then averaging over time.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg_over_time(sum(slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"})[$__range:])",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Avg cluster utilization (window)",
      "description": "Average over the window of (sum of DCGM util / sum of allocated GPUs). Allocation-weighted, only counts time when GPUs were actually held by jobs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg_over_time(\n  (sum(DCGM_FI_DEV_GPU_UTIL * on(Hostname, gpu) group_left slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"})\n   / sum(slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}))[$__range:]\n)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 70 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Avg underutilized GPU-eq (window)",
      "description": "Average GPU-equivalents that were allocated but idle. Computed as avg_over_time of sum((1 - util/100) per allocated GPU). Concrete units of waste.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg_over_time(\n  sum((1 - DCGM_FI_DEV_GPU_UTIL/100)\n      * on(Hostname, gpu) group_left\n        slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"})[$__range:]\n)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU utilization by GPU type",
      "description": "Average DCGM utilization across all allocated GPUs of each type. Idle (unallocated) GPUs are excluded by the slurm_job_gpu_index join.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (gpu_type) (\n  DCGM_FI_DEV_GPU_UTIL\n  * on(Hostname, gpu) group_left(user, gpu_type)\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n)",
          "legendFormat": "{{gpu_type}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization by user (top 10)",
      "description": "Average DCGM utilization across each user's currently-allocated GPUs. Use this to identify users with idle allocations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10,\n  avg by (user) (\n    DCGM_FI_DEV_GPU_UTIL\n    * on(Hostname, gpu) group_left(user, gpu_type)\n      slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n  )\n)",
          "legendFormat": "{{user}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU allocation %, by GPU type",
      "description": "Fraction of each GPU type currently allocated (allocated / total). 100% means that GPU pool is fully booked; lower values mean headroom available.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * slurm_gpus_alloc_by_type{gpu_type=~\"$gpu_type\", gpu_type!~\"titanrtx|titanxp\"}\n  / on(gpu_type) slurm_gpus_total_by_type",
          "legendFormat": "{{gpu_type}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPUs in use by partition × user (top 15)",
      "description": "Stacked view broken down by user, useful for spotting who's holding GPUs on each partition.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(15,\n  sum by (user, partition) (\n    slurm_user_partition_gpus_running{user=~\"$user\", partition=~\"$partition\"}\n  )\n)",
          "legendFormat": "{{user}} / {{partition}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PCIe RX throughput by user (top 10)",
      "description": "Top users by average PCIe host->GPU transfer rate. High RX with low GPU_UTIL = classic data-loading-bound workload (GPU starved waiting for data).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10,\n  avg by (user) (\n    rate(DCGM_FI_PROF_PCIE_RX_BYTES[5m])\n    * on(Hostname, gpu) group_left(user, gpu_type)\n      slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n  )\n)",
          "legendFormat": "{{user}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU workload classification (count of allocated GPUs)",
      "description": "Each line counts how many allocated GPUs show that workload pattern. Categories are NOT mutually exclusive — a single GPU can register in multiple lines. Thresholds tuned to this cluster's observed activity (which runs cold; p90 PCIe is ~5 MB/s, p90 MEM_COPY is ~0%): compute-bound=GPU_UTIL>=50%; I/O-bound=GPU_UTIL<50% AND PCIe RX>=5 MB/s (loose: 'any meaningful data movement'); memory-bound=GPU_UTIL<50% AND MEM_COPY_UTIL>=10% (loose: 'any meaningful HBM activity'); idle=GPU_UTIL<10% AND MEM_COPY_UTIL<10% AND PCIe RX<10 MB/s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(\n  (DCGM_FI_DEV_GPU_UTIL >= 50)\n  * on(Hostname, gpu) group_left\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n)",
          "legendFormat": "compute-bound",
          "interval": "1m"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(\n  ((DCGM_FI_DEV_GPU_UTIL < 50) and (rate(DCGM_FI_PROF_PCIE_RX_BYTES[5m]) >= 5*1024*1024))\n  * on(Hostname, gpu) group_left\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n)",
          "legendFormat": "I/O-bound",
          "interval": "1m"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(\n  ((DCGM_FI_DEV_GPU_UTIL < 50) and (DCGM_FI_DEV_MEM_COPY_UTIL >= 10))\n  * on(Hostname, gpu) group_left\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n)",
          "legendFormat": "memory-bound",
          "interval": "1m"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(\n  ((DCGM_FI_DEV_GPU_UTIL < 10) and (DCGM_FI_DEV_MEM_COPY_UTIL < 10) and (rate(DCGM_FI_PROF_PCIE_RX_BYTES[5m]) < 10*1024*1024))\n  * on(Hostname, gpu) group_left\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n)",
          "legendFormat": "idle",
          "interval": "1m"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"})",
          "legendFormat": "total allocated",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "lineWidth": 2
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total allocated" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 5] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "idle" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "compute-bound" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "I/O-bound" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "memory-bound" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "User GPU efficiency over selected time window (sorted: worst utilization first)",
      "description": "For each user with allocations during the time window: average GPU utilization (DCGM) and average concurrent GPUs allocated. The 'underutilized GPU-eq' column is avg_gpus × (1 - util/100), i.e. how many GPUs were effectively idle on average. Sort by any column. Note: the headline 'avg underutilized GPU-eq' stat at the top is the correct cluster-wide total; summing this column across users in the table over-counts time when users had non-overlapping allocations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (user) (\n  avg_over_time(\n    (DCGM_FI_DEV_GPU_UTIL\n      * on(Hostname, gpu) group_left(user, gpu_type)\n        slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"})[$__range:]\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg_over_time(\n  count by (user) (\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n  )[$__range:]\n) > 0.1",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk by (user) (1,\n  sum by (user, project) (\n    slurm_gpus_running_by_project{user=~\"$user\"}\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "user", "mode": "inner" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "Value #C": true
            },
            "indexByName": {
              "user": 0,
              "project": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "Value #A": "avg util %",
              "Value #B": "avg GPUs allocated"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "avg GPUs allocated",
              "operator": "*",
              "right": "avg util %"
            },
            "reduce": { "reducer": "sum" },
            "alias": "_used_gpu_eq"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "_used_gpu_eq",
              "operator": "/",
              "right": "100"
            },
            "reduce": { "reducer": "sum" },
            "alias": "used GPU-eq"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "avg GPUs allocated",
              "operator": "-",
              "right": "used GPU-eq"
            },
            "reduce": { "reducer": "sum" },
            "alias": "underutilized GPU-eq"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "_used_gpu_eq": true, "used GPU-eq": true },
            "indexByName": {
              "user": 0,
              "project": 1,
              "avg util %": 2,
              "avg GPUs allocated": 3,
              "underutilized GPU-eq": 4
            },
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [{ "field": "underutilized GPU-eq", "desc": true }]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg util %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
