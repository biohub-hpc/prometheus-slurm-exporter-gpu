{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Production Prometheus (monitoring:9090) — needs both DCGM_FI_DEV_GPU_UTIL and slurm_job_gpu_index / slurm_user_partition_gpus_running.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU utilization by GPU type",
      "description": "Average DCGM utilization across all allocated GPUs of each type. Idle (unallocated) GPUs are excluded by the slurm_job_gpu_index join.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (gpu_type) (\n  DCGM_FI_DEV_GPU_UTIL\n  * on(Hostname, gpu) group_left(user, gpu_type)\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n)",
          "legendFormat": "{{gpu_type}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization by user (top 10)",
      "description": "Average DCGM utilization across each user's currently-allocated GPUs. Use this to identify users with idle allocations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10,\n  avg by (user) (\n    DCGM_FI_DEV_GPU_UTIL\n    * on(Hostname, gpu) group_left(user, gpu_type)\n      slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n  )\n)",
          "legendFormat": "{{user}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU allocation %, by GPU type",
      "description": "Fraction of each GPU type currently allocated (allocated / total). 100% means that GPU pool is fully booked; lower values mean headroom available.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * slurm_gpus_alloc_by_type{gpu_type=~\"$gpu_type\", gpu_type!~\"titanrtx|titanxp\"}\n  / on(gpu_type) slurm_gpus_total_by_type",
          "legendFormat": "{{gpu_type}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPUs in use by partition × user (top 15)",
      "description": "Stacked view broken down by user, useful for spotting who's holding GPUs on each partition.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(15,\n  sum by (user, partition) (\n    slurm_user_partition_gpus_running{user=~\"$user\", partition=~\"$partition\"}\n  )\n)",
          "legendFormat": "{{user}} / {{partition}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "User GPU efficiency over selected time window (sorted: worst utilization first)",
      "description": "For each user with allocations during the time window: average GPU utilization (DCGM) and average concurrent GPUs allocated. The 'wasted GPU-eq' column is avg_gpus × (1 - util/100), i.e. how many GPUs were effectively idle on average. Sort by any column.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (user) (\n  avg_over_time(\n    (DCGM_FI_DEV_GPU_UTIL\n      * on(Hostname, gpu) group_left(user, gpu_type)\n        slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"})[$__range:]\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg_over_time(\n  count by (user) (\n    slurm_job_gpu_index{user=~\"$user\", gpu_type=~\"$gpu_type\"}\n  )[$__range:]\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "user", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "job 1": true,
              "job 2": true,
              "instance 1": true,
              "instance 2": true
            },
            "indexByName": {
              "user": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "Value #A": "avg util %",
              "Value #B": "avg GPUs allocated"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "avg GPUs allocated",
              "operator": "*",
              "right": "avg util %"
            },
            "reduce": { "reducer": "sum" },
            "alias": "_used_gpu_eq"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "_used_gpu_eq",
              "operator": "/",
              "right": "100"
            },
            "reduce": { "reducer": "sum" },
            "alias": "used GPU-eq"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "avg GPUs allocated",
              "operator": "-",
              "right": "used GPU-eq"
            },
            "reduce": { "reducer": "sum" },
            "alias": "wasted GPU-eq"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "_used_gpu_eq": true, "used GPU-eq": true },
            "indexByName": {
              "user": 0,
              "avg util %": 1,
              "avg GPUs allocated": 2,
              "wasted GPU-eq": 3
            },
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [{ "field": "wasted GPU-eq", "desc": true }]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg util %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 20 },
                    { "color": "yellow", "value": 50 },
                    { "color": "green", "value": 80 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "avg GPUs allocated" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 1 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "gradient" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "wasted GPU-eq" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 1 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 2 },
                    { "color": "orange", "value": 5 },
                    { "color": "red", "value": 10 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["avg GPUs allocated", "wasted GPU-eq"]
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["slurm", "gpu", "dcgm"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "user",
        "type": "query",
        "label": "User",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(slurm_job_gpu_index, user)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "hide": 0,
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "gpu_type",
        "type": "query",
        "label": "GPU type",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(slurm_gpus_total_by_type{gpu_type!~\"titanrtx|titanxp\"}, gpu_type)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "hide": 0,
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "partition",
        "type": "custom",
        "label": "Partition",
        "query": "interactive,gpu,preempted,cpu",
        "current": { "selected": true, "text": ["interactive", "gpu", "preempted"], "value": ["interactive", "gpu", "preempted"] },
        "options": [
          { "selected": false, "text": "interactive", "value": "interactive" },
          { "selected": false, "text": "gpu", "value": "gpu" },
          { "selected": false, "text": "preempted", "value": "preempted" },
          { "selected": false, "text": "cpu", "value": "cpu" }
        ],
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Slurm GPU Utilization",
  "uid": "slurm-gpu-utilization",
  "version": 1,
  "weekStart": ""
}
